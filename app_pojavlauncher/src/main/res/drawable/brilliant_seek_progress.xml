<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:height="10dp" android:gravity="center_vertical|fill_horizontal">
        <layer-list>
        <item><shape android:shape="rectangle"><solid android:color="#FF16181C" /></shape></item>
        <item android:height="2dp" android:gravity="top|fill_horizontal"><shape android:shape="rectangle"><solid android:color="#FF05070A" /></shape></item>
        <item android:width="2dp" android:gravity="left|fill_vertical"><shape android:shape="rectangle"><solid android:color="#FF05070A" /></shape></item>
        <item android:width="2dp" android:gravity="right|fill_vertical"><shape android:shape="rectangle"><solid android:color="#FF55585C" /></shape></item>
        <item android:height="2dp" android:gravity="bottom|fill_horizontal"><shape android:shape="rectangle"><solid android:color="#FF55585C" /></shape></item>
        </layer-list>
    </item>
    <item android:id="@android:id/progress" android:height="6dp" android:gravity="center_vertical|fill_horizontal" android:left="2dp" android:right="2dp">
        <clip><shape android:shape="rectangle"><solid android:color="#FFF6E0A4" /></shape></clip>
    </item>
</layer-list>
