<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="AppTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/background_status_bar</item>
        <item name="android:navigationBarColor">@color/background_app</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>

        <item name="android:textSize">@dimen/app_text_size</item>
        <item name="colorPrimary">@color/background_app</item>
        <item name="colorPrimaryDark">@color/background_status_bar</item>
        <item name="colorAccent">@color/brilliant_accent</item>
        <item name="colorControlActivated">@color/brilliant_accent</item>
        <item name="colorControlHighlight">@color/brilliant_pressed</item>
        <item name="android:colorAccent">@color/brilliant_accent</item>
        <item name="android:colorControlActivated">@color/brilliant_accent</item>
        <item name="android:colorControlHighlight">@color/brilliant_pressed</item>
        <item name="android:colorControlNormal">@color/secondary_text</item>
        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>
        <item name="android:textColorHint">#FF969CA3</item>
        <item name="android:colorBackground">@color/background_app</item>
        <item name="colorBackgroundFloating">@color/background_app</item>
        <item name="alertDialogTheme">@style/BrilliantDialog</item>
        <item name="android:alertDialogTheme">@style/BrilliantDialog</item>
        <item name="popupMenuStyle">@style/BrilliantPopup</item>
        <item name="android:popupMenuStyle">@style/BrilliantPopup</item>
        <item name="android:editTextStyle">@style/BrilliantField</item>
        <item name="editTextStyle">@style/BrilliantField</item>
        <item name="android:switchStyle">@style/BrilliantSwitch</item>
        <item name="android:checkboxStyle">@style/BrilliantCheckBox</item>
        <item name="checkboxStyle">@style/BrilliantCheckBox</item>
        <item name="android:seekBarStyle">@style/BrilliantSeekBar</item>
        <item name="seekBarStyle">@style/BrilliantSeekBar</item>
        <item name="android:spinnerStyle">@style/BrilliantSpinner</item>
        <item name="spinnerStyle">@style/BrilliantSpinner</item>
        <item name="android:dropDownListViewStyle">@style/BrilliantDropDownList</item>
        <item name="dropDownListViewStyle">@style/BrilliantDropDownList</item>
        <item name="android:buttonStyleToggle">@style/BrilliantChip</item>
    </style>

    <style name="BrilliantDialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/brilliant_accent</item>
        <item name="colorControlActivated">@color/brilliant_accent</item>
        <item name="android:windowBackground">@drawable/brilliant_panel</item>
        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>
        <item name="buttonBarStyle">@style/BrilliantButtonBar</item>
        <item name="buttonBarPositiveButtonStyle">@style/BrilliantDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/BrilliantDialogButton.Quiet</item>
        <item name="buttonBarNeutralButtonStyle">@style/BrilliantDialogButton.Quiet</item>
    </style>

    <style name="BrilliantButtonBar" parent="Widget.AppCompat.ButtonBar.AlertDialog">
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="BrilliantDialogButton" parent="BrilliantChip.Accent">
        <item name="android:layout_marginStart">8dp</item>
    </style>

    <style name="BrilliantDialogButton.Quiet" parent="BrilliantChip">
        <item name="android:layout_marginStart">8dp</item>
    </style>

    <style name="BrilliantChip" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/brilliant_chip</item>
        <item name="android:textColor">@color/brilliant_chip_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="BrilliantChip.Accent">
        <item name="android:background">@drawable/brilliant_chip_accent</item>
        <item name="android:textColor">@color/brilliant_ink</item>
    </style>

    <style name="BrilliantChip.Danger">
        <item name="android:background">@drawable/brilliant_chip_danger</item>
        <item name="android:textColor">@color/brilliant_ink</item>
    </style>

    <style name="BrilliantField" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/brilliant_field</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
    </style>

    <style name="BrilliantSelectText">
        <item name="android:background">@drawable/brilliant_select</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">30dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="BrilliantSpinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/brilliant_select</item>
        <item name="android:popupBackground">@drawable/background_control_editor</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingEnd">30dp</item>
    </style>

    <style name="BrilliantDropDownList" parent="Widget.AppCompat.ListView.DropDown">
        <item name="android:divider">@null</item>
        <item name="android:listSelector">@drawable/brilliant_menu_item_bg</item>
    </style>

    <style name="BrilliantSwitch" parent="android:Widget.Material.CompoundButton.Switch">
        <item name="android:track">@drawable/brilliant_switch_track</item>
        <item name="android:thumb">@drawable/brilliant_switch_thumb</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:switchMinWidth">22dp</item>
        <item name="android:switchPadding">12dp</item>
        <item name="android:showText">false</item>
        <item name="android:background">@null</item>
    </style>

    <style name="BrilliantCheckBox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:button">@drawable/mc_checkbox</item>
        <item name="buttonCompat">@drawable/mc_checkbox</item>
        <item name="buttonTint">@null</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:background">@null</item>
    </style>

    <style name="BrilliantSeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressDrawable">@drawable/brilliant_seek_progress</item>
        <item name="android:thumb">@drawable/brilliant_seek_thumb</item>
        <item name="android:splitTrack">false</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:maxHeight">36dp</item>
        <item name="android:background">@null</item>
    </style>

    <style name="BrilliantPopup" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/background_control_editor</item>
    </style>

    <style name="LauncherFragment_Divider">
        <item name="android:layout_width">@dimen/padding_tiny</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <style name="LauncherMenuButton" parent="Widget.AppCompat.Button">
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="LauncherMenuButton.Universal" parent="LauncherMenuButton">
        <item name="android:layout_height">@dimen/_66sdp</item>
    </style>

    <style name="ThickDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_1sdp</item>
        <item name="android:background">?android:attr/listDivider</item>
    </style>

    <item name="dimension_tracker" type="id" />
    <style name="DimensionTracker">
        <item name="android:id">@id/dimension_tracker</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>
</resources>
